# -------------------------------------------------------------------
# CONFIGURACIÓN DEL ICECAST EXPORTER
# -------------------------------------------------------------------

# URL completa de tu servidor Icecast interno en la LAN
# ⚠️ IMPORTANTE: usar la IP real o hostname accesible desde el contenedor,
# no "localhost".
ICECAST_URL=http://192.168.1.50:8000
ICECAST_INTERNAL_IP=10.2.252.133

# Intervalo de scrapping
SCRAPE_INTERVAL=30s

# Dirección y puerto donde el exporter expone métricas
# Interno en el contenedor (dejá así, no toques el ":")
WEB_LISTEN_ADDRESS=:9146
WEB_TELEMETRY_PATH=/metrics

# Puerto expuesto en el host (para Prometheus)
PORT=9146

# Nombre opcional del servicio (se usa en container_name)
SERVICE_NAME=am

# -------------------------------------------------------------------
# VARIABLES DE PROXY (sólo si necesitás para el build, no para runtime)
# Si no usás proxy, dejalas vacías o comentadas.
# -------------------------------------------------------------------
# HTTP_PROXY=http://proxy.miempresa:3128
# HTTPS_PROXY=http://proxy.miempresa:3128
# NO_PROXY=localhost,127.0.0.1,192.168.1.50
